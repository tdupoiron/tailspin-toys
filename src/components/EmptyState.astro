---
interface Props {
    text?: string;
}

const { text } = Astro.props;
---

<div
    data-testid="empty-state"
    class="text-center py-12 bg-(--color-surface-alt) backdrop-blur-sm rounded-xl border border-(--color-border)"
>
    {text ? (
        <p data-testid="empty-state-text" class="text-(--color-text-secondary)">{text}</p>
    ) : (
        <slot />
    )}
</div>
